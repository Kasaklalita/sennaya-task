{
  "name": "laptop-status-machine",
  "version": "1.0.0",
  "private": true,
  "description": "Конечный автомат статусов ноутбука на складе: смена статуса с валидацией переходов и журналом изменений",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch --disable-warning=ExperimentalWarning server/index.ts",
    "dev:web": "vite",
    "start": "node --disable-warning=ExperimentalWarning dist-server/index.js",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "build": "tsc -p tsconfig.build.json",
    "build:server": "tsc -p tsconfig.server.json",
    "build:web": "vite build",
    "check": "npm run typecheck && npm run coverage"
  },
  "keywords": [
    "state-machine",
    "fsm",
    "typescript"
  ],
  "license": "MIT",
  "comments": {
    "dependencies": "Домен (src/) не зависит ни от чего. Всё перечисленное ниже нужно только демо-фронтенду в web/ и собирается Vite в бандл, поэтому лежит в devDependencies: потребитель пакета (files: dist) React не устанавливает."
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.6",
    "lucide-react": "^1.54.0",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
